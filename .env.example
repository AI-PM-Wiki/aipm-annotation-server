# ---- 服务 ----
PORT=8788
# 绑定地址:默认仅回环 127.0.0.1;公网暴露需显式 HOST=0.0.0.0 并自备防护
HOST=127.0.0.1
SITE_BASE=https://aipm.ac
# 站点来源白名单(浏览器跨源请求的 Origin);本地预览端口一并放进来
ALLOWED_ORIGINS=https://aipm.ac,http://localhost:8000,http://127.0.0.1:8000
# OAuth 回跳白名单(开放重定向防护);留空 = 跟 ALLOWED_ORIGINS 一致
RETURN_ORIGINS=

# ---- 存储 ----
DATA_DIR=./data
MAX_ANNOTATIONS=20000
MAX_ANNOTATIONS_PER_PAGE=500
MAX_REPLIES_PER_ANNOTATION=200
MAX_BODY_CHARS=4000

# ---- 请求体与限流 ----
BODY_LIMIT_BYTES=262144
BODY_TIMEOUT_MS=15000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=600000
# 每账号写入配额(比按 IP 准:同一 NAT 后的人不互相挤)
WRITE_QUOTA_MAX=60
WRITE_QUOTA_WINDOW_MS=3600000
CONCURRENCY_LIMIT=8
QUEUE_LIMIT=16
QUEUE_WAIT_MS=30000
# 无 Origin 请求(curl/脚本)须携带 X-API-Key;留空 = 不校验
API_KEY=
# VPS + Cloudflare 隧道部署必须为 true(限流取 cf-connecting-ip 真实 IP)
TRUST_PROXY=true
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# ---- GitHub OAuth(必填;本地开发可用 DEV_AUTH_BYPASS 绕过)----
# 在 https://github.com/settings/developers 新建 OAuth App,回调地址必须与
# OAUTH_CALLBACK_URL 完全一致(线上域名待用户确认)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://anno-api.nvc.ac/api/auth/github/callback
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_BASE=https://api.github.com

SESSION_TTL_MS=2592000000
AUTH_CODE_TTL_MS=60000
OAUTH_STATE_TTL_MS=600000
# 版主登录名(逗号分隔):只多一项「删除公开批注」的能力,不能看他人私有、不能改他人内容
MODERATOR_LOGINS=

# 本地开发:仅当 HOST 为回环地址时生效;配成 0.0.0.0 时即便写 true 也强制关闭
DEV_AUTH_BYPASS=false
DEV_AUTH_LOGIN=dev-user

# ---- 站内索引(judge 用它校验 blocks 确属该页)----
SEARCH_INDEX_URL=https://aipm.ac/search/search_index.json
INDEX_REFRESH_MS=1800000
INDEX_SAMPLE_CHARS=120

# ---- 智能高亮:路由 ----
HIGHLIGHT_JUDGE_PRIMARY=jev
HIGHLIGHT_JUDGE_FALLBACK=llm
# 只对有原生 confidence 的 provider 生效(Jev 低置信 → 回退 LLM)
HIGHLIGHT_JUDGE_FALLBACK_THRESHOLD=0.6
HIGHLIGHT_WORTH_THRESHOLD=0.5

# ---- Jev(TypeSafe System One,主判分;early access,拿不到 key 就只跑 LLM)----
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=20000

# ---- LLM(Anthropic,兜底判分;与问答服务共用同一个 key,预算独立计)----
ANTHROPIC_API_KEY=
# 批量分类/抽取型判断用便宜快速的档;想抬质量换成 claude-sonnet-5 / claude-opus-5
HIGHLIGHT_MODEL=claude-haiku-4-5
HIGHLIGHT_MAX_TOKENS=8000
HIGHLIGHT_TIMEOUT_MS=60000

# ---- 智能高亮:防滥用 ----
HIGHLIGHT_MAX_BLOCKS=120
HIGHLIGHT_MAX_CHARS=24000
HIGHLIGHT_CHUNK_BLOCKS=40
HIGHLIGHT_CHUNK_CHARS=8000
HIGHLIGHT_MAX_SUGGESTIONS=12
# 判分限流(匿名可用,按 IP;比批注接口严)
HIGHLIGHT_RATE_LIMIT_MAX=10
HIGHLIGHT_RATE_LIMIT_WINDOW_MS=600000
# 判分每日护栏(独立于问答服务:两个服务独立部署、各自对账)
HIGHLIGHT_DAILY_BUDGET_USD=0.5
HIGHLIGHT_DAILY_CALLS_JEV=300
HIGHLIGHT_DAILY_CALLS_LLM=200
# 计价(USD/百万 token),只用于日志对账;拿不到 Jev 报价就保持 0(只记 token)
LLM_INPUT_COST_PER_MTOK=1
LLM_OUTPUT_COST_PER_MTOK=5
JEV_INPUT_COST_PER_MTOK=0
# 同页结果缓存(同页重复点击不重复计费)
HIGHLIGHT_CACHE_TTL_MS=900000
HIGHLIGHT_CACHE_MAX_ENTRIES=200
