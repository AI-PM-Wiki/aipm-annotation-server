# ---- 服务 ----
PORT=8788
# 绑定地址。**docker compose 部署必须设 0.0.0.0**:容器内绑自身回环时,
# 宿主的 127.0.0.1:8788 端口映射连不进去(容器内 healthz 健康、外面却 502)。
# 0.0.0.0 只作用于容器内;宿主仍只绑回环,公网不可直达。
# bare `npm start`(非容器)保持 127.0.0.1 即可。
HOST=0.0.0.0
SITE_BASE=https://aipm.ac
# 站点来源白名单(浏览器跨源请求的 Origin);本地预览端口一并放进来
ALLOWED_ORIGINS=https://aipm.ac,http://localhost:8000,http://127.0.0.1:8000
# OAuth 回跳白名单(开放重定向防护);留空 = 跟 ALLOWED_ORIGINS 一致
RETURN_ORIGINS=

# ---- 存储 ----
DATA_DIR=./data
MAX_ANNOTATIONS=20000
MAX_ANNOTATIONS_PER_PAGE=500
MAX_REPLIES_PER_ANNOTATION=200
MAX_BODY_CHARS=4000

# ---- 请求体与限流 ----
BODY_LIMIT_BYTES=262144
BODY_TIMEOUT_MS=15000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=600000
# 每账号写入配额(比按 IP 准:同一 NAT 后的人不互相挤)
WRITE_QUOTA_MAX=60
WRITE_QUOTA_WINDOW_MS=3600000
CONCURRENCY_LIMIT=8
QUEUE_LIMIT=16
QUEUE_WAIT_MS=30000
# 无 Origin 请求(curl/脚本)须携带 X-API-Key;留空 = 不校验
API_KEY=
# VPS + Cloudflare 隧道部署必须为 true(限流取 cf-connecting-ip 真实 IP)
TRUST_PROXY=true
# 可信代理地址:**必须补上 docker 网桥网关**,否则转发头被忽略、全站按一个 IP 限流。
# 容器内看到的直连来源是网桥网关(如 172.30.0.1),不是 127.0.0.1 —— 实测
# agent-server 就踩了这个坑(日志里出现 untrusted_proxy_ignored)。
# 本服务的 compose 把网络固定成 172.30.0.0/24,故网关确定为 172.30.0.1。
# 验证方法:启动后 `docker logs` 里没有 untrusted_proxy_ignored 即正确。
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1,172.30.0.1

# ---- GitHub OAuth(必填;本地开发可用 DEV_AUTH_BYPASS 绕过)----
# 在 https://github.com/settings/developers 新建 OAuth App(scope 只要 read:user),
# 回调地址必须与 OAUTH_CALLBACK_URL 逐字符一致,否则 GitHub 报 redirect_uri_mismatch。
# OAuth App 只能登记一个回调地址,本地开发因此走 DEV_AUTH_BYPASS,不用第二个地址。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=https://anno-api.nvc.ac/api/auth/github/callback
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_BASE=https://api.github.com

SESSION_TTL_MS=2592000000
AUTH_CODE_TTL_MS=60000
OAUTH_STATE_TTL_MS=600000
# 版主登录名(逗号分隔):只多一项「删除公开批注」的能力,不能看他人私有、不能改他人内容
MODERATOR_LOGINS=
# 站长登录名(逗号分隔):多一项「重新生成智能高亮」的能力 —— 跳过同页缓存重新判分
# 并覆盖缓存。它每点一次就是一轮 provider 调用,是唯一会重复花钱的入口,所以只给站长。
ADMIN_LOGINS=huangyincan

# 本地开发:仅当 HOST 为回环地址时生效;配成 0.0.0.0 时即便写 true 也强制关闭
DEV_AUTH_BYPASS=false
DEV_AUTH_LOGIN=dev-user

# ---- 站内索引(judge 用它校验 blocks 确属该页)----
SEARCH_INDEX_URL=https://aipm.ac/search/search_index.json
INDEX_REFRESH_MS=1800000
INDEX_SAMPLE_CHARS=120

# ---- 智能高亮:路由 ----
HIGHLIGHT_JUDGE_PRIMARY=jev
# 兜底判分器。设 none 则只跑 Jev —— 那样 Jev 一超时就整页 503,别在只有一家
# provider 时设 none。llm 可用官方 Anthropic,也可指向兼容端点(见下面 ANTHROPIC_BASE_URL)。
HIGHLIGHT_JUDGE_FALLBACK=llm
# 唯一的判分门槛:provider 打的 worth 低于它就不下发建议。
# (曾经还有一条「低 confidence → 回退」的阈值,2026-09-22 按线上实测删掉了:
#  Jev 的 confidence 量的是颜色/重要度答得笃不笃定,不覆盖「值不值得高亮」,
#  拿它当门槛会让首页这类页面整体回退到贵 12 倍的兜底模型。)
HIGHLIGHT_WORTH_THRESHOLD=0.5

# ---- Jev(TypeSafe System One,主判分;early access,拿不到 key 就只跑 LLM)----
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=20000

# ---- LLM(兜底判分,Anthropic Messages API)----
ANTHROPIC_API_KEY=
# 端点覆盖。留空 = 官方 api.anthropic.com。
# 指到 Anthropic 兼容端点(如 DeepSeek 的 https://api.deepseek.com/anthropic)时,
# 必须让 HIGHLIGHT_LLM_MODE 落到 json:这类端点会**静默忽略** output_config.format、
# 回普通文本,结构化输出直接解析失败(2026-09 实测)。不写 mode 会自动按端点推断,
# 但显式写 structured 又配第三方端点会启动即报错 —— 这是故意的,不留配了却跑不通的活口。
ANTHROPIC_BASE_URL=
# structured(官方结构化输出) / json(纯文本 + 自己抠 JSON)。留空按 ANTHROPIC_BASE_URL 推断。
HIGHLIGHT_LLM_MODE=
# 批量分类/抽取型判断用便宜快速的档;想抬质量换成 claude-sonnet-5 / claude-opus-5。
# 走 DeepSeek 时填它的模型名(如 deepseek-chat)。
HIGHLIGHT_MODEL=claude-haiku-4-5
HIGHLIGHT_MAX_TOKENS=8000
HIGHLIGHT_TIMEOUT_MS=60000

# ---- 智能高亮:防滥用 ----
# 每请求硬上限。2026-09 实测全站 601 页:最长 654 块 / 29,639 字符,按两倍留冗余。
# 两个必须一起抬:只抬块数会让字符本就超限的页面从「被截断」变成 400。
HIGHLIGHT_MAX_BLOCKS=1308
HIGHLIGHT_MAX_CHARS=60000
HIGHLIGHT_CHUNK_BLOCKS=40
HIGHLIGHT_CHUNK_CHARS=8000
# 片间并发。片之间无依赖;串行跑 17 片会超过 Cloudflare ~100s 的代理超时。
HIGHLIGHT_CHUNK_CONCURRENCY=4
HIGHLIGHT_MAX_SUGGESTIONS=12
# 判分限流(匿名可用,按 IP;比批注接口严)
HIGHLIGHT_RATE_LIMIT_MAX=10
HIGHLIGHT_RATE_LIMIT_WINDOW_MS=600000
# 判分每日护栏(独立于问答服务:两个服务独立部署、各自对账)
HIGHLIGHT_DAILY_BUDGET_USD=0.5
# 一次点击按片数计次:最长页面 17 片 = 17 次调用。
HIGHLIGHT_DAILY_CALLS_JEV=1200
HIGHLIGHT_DAILY_CALLS_LLM=200
# 计价(USD/百万 token),用于日志对账与日预算预占。
# 走第三方端点时按它自己的价目表改,否则日预算护栏会算错账。
LLM_INPUT_COST_PER_MTOK=1
LLM_OUTPUT_COST_PER_MTOK=5
# Jev 公开费率:$42/Btok = $0.042/Mtok(输出免费),见 docs.typesafe.ai/models.md。
# 保持 0 会让日预算护栏对 Jev 完全失效(只剩调用次数上限兜底)。
JEV_INPUT_COST_PER_MTOK=0.042
# 同页结果缓存(同页重复点击、以及后来的访客都不重复计费)。
# key 里带页面正文哈希,所以「内容没变就复用」是安全的;TTL 只管答案的陈旧度。
# 缓存在 DATA_DIR/highlight-cache.json 落盘,重启/重新部署不丢。
HIGHLIGHT_CACHE_TTL_MS=604800000
HIGHLIGHT_CACHE_MAX_ENTRIES=800
