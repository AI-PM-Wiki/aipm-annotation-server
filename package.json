{
  "name": "aipm-annotation-server",
  "version": "0.1.0",
  "private": true,
  "description": "AI-PM Wiki 自建批注后端:GitHub OAuth + 公开/私有批注存储 + Jev/LLM 智能高亮 judge",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "unit-check": "tsx src/unit-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
